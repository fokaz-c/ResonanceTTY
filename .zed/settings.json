{
	"tab_size": 4,
	"hard_tabs": true,
	"format_on_save": "off",
	"file_types": {
		"C": ["c", "h"]
	},
	"languages": {
		"C": {
			"tab_size": 8,
			"hard_tabs": true,
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "clang-format",
					"arguments": ["-style=file"]
				}
			}
		},
		"JSON": {
			"format_on_save": "off"
		}
	}
}
